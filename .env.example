# -------------------------------------------------------------
# .env.local — Variables de entorno del sitio (No commitear).
#
# IMPORTANTE:
#  - Este archivo (y similares .env*) está ignorado por git (ver .gitignore).
#  - Nunca guardes credenciales reales de producción acá como parte del
#    proceso: para despliegue en Vercel usá el panel de Vercel.
# -------------------------------------------------------------

# --- MongoDB (requerido para las páginas de proyectos /admin /sitemap) ---
MONGODB_URI="mongodb://localhost:27017/lucio-portfolio"

# --- Admin panel (credenciales; la contraseña se guarda hasheada en MongoDB) ---
ADMIN_PASSWORD="cambia-esto-por-una-contrasena-fuerte"
AUTH_SECRET="cambia-esto-por-una-cadena-aleatoria-larga-min-32-caracteres-xyz123"

# --- EmailJS (formulario de contacto; PUBLIC_KEY es de diseño público) ---
NEXT_PUBLIC_EMAILJS_SERVICE_ID="ID_del_Servicio_EmailJS"
NEXT_PUBLIC_EMAILJS_TEMPLATE_ID="ID_de_la_Plantilla_EmailJS"
NEXT_PUBLIC_EMAILJS_PUBLIC_KEY="ClavePublica_de_EmailJS"
NEXT_PUBLIC_CONTACT_EMAIL="lucioingargiola1@gmail.com"

# --- Vercel (generado por la plataforma en build-time) ---
VERCEL_OIDC_TOKEN="(proporcionado por Vercel; no confundir con secretos locales)"
