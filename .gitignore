# Archivos que GIT ignora (no se versionan).
# Doc oficial: https://help.github.com/articles/ignoring-files/

# --- Dependencias npm (se regeneran con `npm install`) ---
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# --- Next.js ---
# .next: build de desarrollo, se regenera solo.
# out: build de exportación estática, se regenera con `next build`.
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
*.log
dev.log

# --- Documentación interna (no se publica) ---
GUIA-INTERNA.md

# --- Variables de entorno ---
# .env.local (y similares) contienen secretos: NUNCA deben subirse a git.
# Creá tu propio .env.local a partir de .env.example (no incluido aún).
.env*
# Excepción: si algún día querés versionar un .env de ejemplo:
# !.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
